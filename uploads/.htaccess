# Never execute scripts uploaded here — serve as static only
<FilesMatch "\.(php|php\d|phtml|phps|pht|phar|cgi|pl|py|asp|aspx|sh|svgz?)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
php_flag engine off
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .phar
RemoveType .php .phtml .php3 .php4 .php5 .php7 .phar
